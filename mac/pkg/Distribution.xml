<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Meltype for Mac</title>
    <welcome file="welcome.html"/>
    <conclusion file="conclusion.html"/>
    <!-- 「このユーザーのみ」にインストールする (~/Library/Input Methods)。管理者権限は要らない -->
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" visible="false">
        <pkg-ref id="io.github.yksr-melt.inputmethod.Meltype.pkg"/>
    </choice>
    <pkg-ref id="io.github.yksr-melt.inputmethod.Meltype.pkg" version="VERSION" onConclusion="none">Meltype-component.pkg</pkg-ref>
</installer-gui-script>
