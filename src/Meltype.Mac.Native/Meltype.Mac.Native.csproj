<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mac 版の IME (mac/ の Swift) から呼ぶ、Meltype の入力の本体のライブラリ。
    Mac で NativeAOT の共有ライブラリにする (mac/build.sh):
      dotnet publish src/Meltype.Mac.Native -c Release -r osx-arm64 -p:PublishAot=true -p:NativeLib=Shared
    PublishAot はここには書かない (書くと Windows でのふつうのビルドでも NuGet から AOT のコンパイラを取りに行くため)。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MeltypeNative</AssemblyName>
    <RootNamespace>Meltype.Mac</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 設定・学習データの JSON は型を見て読み書きする (System.Text.Json の reflection)。NativeAOT では既定で無効なので有効にし、
         Meltype.Core の型を削らずに残す (削ると、設定を読めない・学習を保存できない)。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Meltype.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
</Project>
