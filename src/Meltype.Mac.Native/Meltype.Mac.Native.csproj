<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mac 版の IME (mac/ の Swift) から呼ぶ、Meltype の入力の本体のライブラリ。
    Mac で NativeAOT の共有ライブラリにする (mac/build.sh):
      dotnet publish src/Meltype.Mac.Native -c Release -r osx-arm64 -p:PublishAot=true -p:NativeLib=Shared
    PublishAot はここには書かない (書くと Windows でのふつうのビルドでも NuGet から AOT のコンパイラを取りに行くため)。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MeltypeNative</AssemblyName>
    <RootNamespace>Meltype.Mac</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 設定・学習データの JSON はソース生成 (SettingsJsonContext・LearningJsonContext・UserModelJsonContext) で読み書きする。
         reflection だと NativeAOT で列挙型などが「metadata が無い」の例外になる (managed のテストでは見つからない)。
         ここで reflection を有効にしているのは、ソース生成にしていない JSON が残っても動くようにするための保険。
         JSON を足すときは、ソース生成にして、tools/check-mac-aot-settings.py で確かめる。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Meltype.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
</Project>
