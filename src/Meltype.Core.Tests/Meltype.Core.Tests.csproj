<Project Sdk="Microsoft.NET.Sdk">
  <!-- Meltype.Core のテスト (Windows 以外でも動く)。NuGet が使えないので xUnit の代わりに小さなテストランナーを使う。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Meltype.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
    <InternalsVisibleTo Include="Meltype.Tests" />
  </ItemGroup>
</Project>
